# Copy to .env (repo root). Real environment variables take precedence.
# Signs the session cookie. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is created once in instance/secret_key and reused.
NEXORA_SECRET_KEY=
# NEXORA_DB=instance/nexora.db
# NEXORA_HOST=127.0.0.1
# NEXORA_PORT=5000
# NEXORA_RATE_LIMIT=60          # messages per minute per browser session
# NEXORA_COOKIE_SECURE=1        # set to 1 when served over HTTPS
